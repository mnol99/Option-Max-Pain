# =============================================================================
# Option-Max-Pain — trading stack (copy to .env.local on the VPS, then:
#   npm run build && restart next start
# Excluded from this file on purpose: secrets (API keys, wallet keypair, base64).
# =============================================================================

# --- Secrets (add these yourself; do not commit) ---
# ARKHAM_API_KEY=...
# SOLANA_TRADING_WALLET_KEYPAIR=/opt/Option-Max-Pain/.secrets/trader.json
#   OR: SOLANA_TRADING_WALLET_SECRET_BASE64=...

# --- Public Solana (match client + server; prefer a dedicated RPC on production) ---
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# SOLANA_RPC=...   # optional; Doves can use this if set

# --- Server signing: required for /api/solana-bot/execute signAndSend, hourly SOL band, unattended BLK in live
SOLANA_TRADING_SERVER_SIGNING=1
# Expose the same in the browser for /trade "live" + autosign (must match the keypair above)
NEXT_PUBLIC_SOLANA_SERVER_AUTOSIGN=1
# Optional: show which wallet the UI will label for server trades (your hot wallet pubkey)
# NEXT_PUBLIC_SOLANA_SERVER_TRADING_WALLET=YourPubkeyBase58

# --- Inside-bar: SOL/ETH/BTC 60m + daily (candles on disk, server tick in paper) ---
INSIDE_BAR_CANDLES_PERSIST_PATH=.data/inside-bar-candles.json
SOL_60M_MERGE_BINANCE_OHLC=1
ETH_60M_MERGE_BINANCE_OHLC=1
BTC_60M_MERGE_BINANCE_OHLC=1
# Throttle for Binance 60m merge (all three assets use this value)
BINANCE_60M_MERGE_INTERVAL_MS=60000
# Legacy alias; prefer BINANCE_60M above — kept for compatibility
# SOL_60M_BINANCE_MERGE_INTERVAL_MS=60000
INSIDE_BAR_ENTRY_AT_BREAKOUT=1
NEXT_PUBLIC_INSIDE_BAR_ENTRY_AT_BREAKOUT=1
# Doves throttling (SOL mark on-chain read)
DOVES_MIN_FETCH_INTERVAL_MS=1000
# Default matches Jupiter execution path; set SOLANA_PRICE_SOURCE=pyth to use Pyth for hourly band + /api/price?asset=sol
# SOLANA_PRICE_SOURCE=doves

# --- BLK / IBIT (Arkham batch + simple pair) —
IBIT_SIGNAL_MAX_AGE_SEC=86400
# Turn off the **legacy** Blockstream scan of IBIT_COINBASE_ADDRESSES only; Arkham batch is unchanged
IBIT_DISABLE_COINBASE_POLL=1
ARKHAM_BATCH_MODE=1
ARKHAM_BATCH_SIMPLE_PAIR=1
ARKHAM_BATCH_PAIR_MIN_BTC=200
ARKHAM_TRANSFER_LIMIT=100
# Do **not** set ARKHAM_DISABLE_IBIT_POLL=1 (that would turn Arkham off entirely)
BLK_DISABLE_LONG_BUY_CUTOFF=1

# --- Hourly “prior high / low” SOL band (server-side market emulation; needs SOLANA_TRADING_SERVER_SIGNING + keypair) ---
HOURLY_BAND_SOL_ENABLED=1
# HOURLY_BAND_SOL_SIZE_USD=50
# HOURLY_BAND_SOL_LEVERAGE=1.5
# HOURLY_BAND_SOL_POLL_MS=5000
# HOURLY_BAND_SOL_TRIGGER_EPS=0.0005
# State file (default .data/hourly-band-sol.json)
# OPTION_MAX_PAIN_DATA_DIR=.data

# =============================================================================
# Optional tunables (defaults are fine if omitted)
# =============================================================================
# NEXT_PUBLIC_INSIDE_BAR_SYNC_MS=2000
# INSIDE_BAR_HEARTBEAT_MS=3000
# IBIT_DISABLE_SERVER_POLL=0
# IBIT_ARKHAM_POLL_SCHEDULE=1
# ARKHAM_TRANSFER_BASE=blackrock
# ARKHAM_TIME_LAST=7d
